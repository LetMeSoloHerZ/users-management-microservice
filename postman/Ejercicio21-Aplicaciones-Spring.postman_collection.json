            "description": "",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"{{appNombre}}\",\n  \"proveedor\": \"ACME S.A.\",\n  \"categoria\": \"DESARROLLO\",\n  \"lenguajePrincipal\": \"Java\",\n  \"lenguajeSecundario\": \"Kotlin\",\n  \"usaBd\": true,\n  \"requiereConexionRed\": true,\n  \"numBits\": 64,\n  \"sistemaOperativo\": \"MULTIPLATAFORMA\",\n  \"requisitosHardware\": \"4 GB de RAM\",\n  \"licencia\": \"COMERCIAL\",\n  \"precio\": 19.99,\n  \"descripcion\": \"Aplicacion creada desde Postman\",\n  \"web\": \"https://acme.example.com\",\n  \"correo\": \"contacto@acme.example.com\",\n  \"tamanoInstalador\": 120.5\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set('appNombre', 'App Postman ' + Date.now());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "const a = pm.response.json();",
                  "pm.test('Devuelve id UUID', () => pm.expect(a.id).to.match(/^[0-9a-f-]{36}$/));",
                  "pm.test('Datos guardados', () => { pm.expect(a.licencia).to.eql('COMERCIAL'); pm.expect(a.precio).to.eql(19.99); pm.expect(a.numBits).to.eql(64); });",
                  "pm.collectionVariables.set('appId', a.id);"
                ]
              }
            }
          ]
        },
